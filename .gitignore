# Release allowlist. Local credentials, browser profiles, research, downloads,
# course archives and generated output are ignored unless explicitly allowed.
*
!/.gitignore
!/README.md
!/LICENSE
!/manage.py
!/mcp_server.py
!/server.py
!/requirements.txt
!/requirements-browser.txt
!/config.example.toml
!/pku3b.example.toml
!/codex-mcp.example.toml

!/campus/
!/campus/*.py
!/docs/
!/docs/API.md
!/scripts/
!/scripts/*.py
!/tests/
!/tests/test_*.py
!/web/
!/web/index.html
!/web/app.js
!/web/style.css

!/data/
!/data/activities.json

!/.dsh/
!/.dsh/skills/
!/.dsh/skills/pku-campus/
!/.dsh/skills/pku-campus/SKILL.md
!/.dsh/skills/pku-campus/references/
!/.dsh/skills/pku-campus/references/activities.md
!/.dsh/skills/pku-campus/references/daily.md
!/.dsh/skills/pku-campus/references/operations.md
!/.dsh/skills/pku-campus/references/retrieval.md
!/.dsh/skills/pku-campus/scripts/
!/.dsh/skills/pku-campus/scripts/daily_review.py
!/.dsh/skills/pku-campus/scripts/scan_daily.py
